{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["airtable/**/*.js", "airtable/**/*.jsx", "airtable/**/*.d.ts"],
  "exclude": ["node_modules"]
}
